{
  "name": "reader-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "test": "bun test",
    "test:webview": "bun run build && WEBVIEW=1 bun test test/webview.test.ts",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.4",
    "feedsmith": "^3.0.1",
    "lite-youtube-embed": "^0.3.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0",
    "vite": "^8.3.4"
  }
}
