{
  "name": "miniflux-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=3007 bun run --watch server/hono.tsx",
    "typecheck": "bunx --bun tsc --noEmit",
    "build:css": "bunx @tailwindcss/cli -i ./main.css -o ./public/style.css --source ./server",
    "build:css:watch": "bun run build:css -- --watch"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@starfederation/datastar-sdk": "^1.0.0",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.3.14",
    "typescript": "~7.0.2"
  }
}